# Copy to .env (git-ignored). Each key unlocks an extra data source; everything works without them.
FEC_API_KEY=            # https://api.data.gov/signup  (free, 1,000 req/hour) -> fresh FEC totals + outside spending
FOLLOWTHEMONEY_API_KEY= # https://www.followthemoney.org (free account) -> governor fundraising (state filings)
CENSUS_API_KEY=         # https://api.census.gov/data/key_signup.html (free) -> district demographics for correlated errors
OPENCODE_API_KEY=       # https://opencode.ai/auth -> decision layer (GLM 5.3 Flash via OpenCode Zen, ~$0.15/M in, $0.50/M out)
# AI_MODEL=glm-5.3-flash   # any Zen chat model id; the '-free' tiers only work inside the OpenCode client
