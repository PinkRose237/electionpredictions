ight": 0.57, "fundamentals": {"margin": 13.25, "lean": 9.0, "environment": 4.35, "incumbency": 0.0, "money": -0.1}, "rating_margin": 16.0, "sigma_race": 5.0, "sigma_total": 5.41, "baseline_margin": 19.58, "analyst_adjustment": 0.42, "key_factors": ["California's strong Democratic lean (D+12 PVI) in an open-seat race", "Consistent late-October polling showing Becerra ahead by roughly 20-29 points", "Unanimous Solid/Safe D ratings from all eight expert raters", "Prediction markets price Becerra at 97-98% to win"], "rationale": "Every recent poll shows Becerra leading by double digits, averaging around 23 points, and all eight expert ratings call the race Solid or Safe Democratic. Markets at 97-98% and the state's D+12 baseline leave no evidence pointing toward an upset, so the forecast stays at a roughly 20-point Democratic margin.", "watch": "A sharp late turnout differential or a polling miss comparable to 2014-style low-turnout elections could narrow the margin, though not enough to threaten the outcome.", "confidence": "medium", "notes": ["Open seat: Gavin Newsom (D) is not on the ballot."]}, "overview": "California's open governor's race pits Democrat Xavier Becerra against Republican Steve Hilton to succeed term-limited Gavin Newsom. The state's D+12 partisan lean gives Becerra a strong structural advantage, and late-October polls consistently show him ahead by 20 points or more, with the Los Angeles Times reporting his lead widening as voter attention turns to national politics.\n\nAll eight expert raters call the race Solid or Safe Democratic, and prediction markets price Becerra's chances at 97-98%. Hilton has kept pace with Becerra in fundraising and campaigned aggressively in the closing days, but there is no sign of a meaningful shift in the polling or the fundamentals. The race is rated Safe Democratic.", "history": [{"date": "2026-09-22", "p_dem": 0.9963, "margin": 17.38}, {"date": "2026-09-23", "p_dem": 0.998, "margin": 20.0}, {"date": "2026-09-24", "p_