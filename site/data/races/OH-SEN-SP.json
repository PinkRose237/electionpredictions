gin.", "history": [{"date": "2026-09-22", "p_dem": 0.7221, "margin": 2.94}, {"date": "2026-09-23", "p_dem": 0.7246, "margin": 3.0}, {"date": "2026-09-24", "p_dem": 0.6986, "margin": 2.5}, {"date": "2026-09-25", "p_dem": 0.7024, "margin": 2.5}, {"date": "2026-09-26", "p_dem": 0.6349, "margin": 2.5}, {"date": "2026-09-27", "p_dem": 0.6393, "margin": 2.5}, {"date": "2026-09-28", "p_dem": 0.6851, "margin": 2.5}, {"date": "2026-09-29", "p_dem": 0.7568, "margin": 3.5}, {"date": "2026-09-30", "p_dem": 0.7432, "margin": 3.5}, {"date": "2026-10-01", "p_dem": 0.7463, "margin": 3.0}, {"date": "2026-10-02", "p_dem": 0.7417, "margin": 3.0}, {"date": "2026-10-03", "p_dem": 0.7438, "margin": 3.0}, {"date": "2026-10-04", "p_dem": 0.7437, "margin": 3.0}, {"date": "2026-10-05", "p_dem": 0.6872, "margin": 3.0}, {"date": "2026-10-06", "p_dem": 0.6759, "margin": 3.0}]}