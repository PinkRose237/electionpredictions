": 17.8, "prior_sd": 5.0, "poll_margin": null, "poll_sd": null, "poll_weight": 0.0, "fundamentals": {"margin": 20.51, "lean": 8.0, "environment": 7.38, "incumbency": 3.0, "money": 2.13}, "rating_margin": 16.0, "sigma_race": 6.3, "sigma_total": 7.0, "baseline_margin": 17.8, "analyst_adjustment": -0.0, "key_factors": ["All ten expert raters call the race Solid or Safe Democratic", "Coons holds a roughly 26-to-1 fundraising edge in cash on hand", "Delaware's Democratic lean plus incumbency gives Coons a strong structural advantage", "Markets price Coons at 98-99 percent to win"], "rationale": "Every available signal points the same way: raters unanimously call Delaware Solid or Safe Democratic, markets price Coons near 99 percent, and his $4.8 million war chest dwarfs Katz's $98 thousand. With no general-election polls to contradict the state's D+8 lean and incumbency advantage, the fundamentals-based margin of roughly 18 points stands.", "watch": "A scandal gaining traction from the reporting on redirected contractor donations could tighten the race, though Katz's minimal resources limit his ability to exploit it.", "confidence": "high", "notes": ["No usable general-election polls; forecast rests on fundamentals and expert ratings.", "Incumbent Chris Coons (D) is running."]}, "overview": "Senator Chris Coons enters the general election as a heavy favorite over Republican Michael Katz in solidly blue Delaware. Coons easily won renomination and has raised over $4.1 million with $4.8 million on hand, while Katz, a physician who won his primary, has raised under $160,000. All ten expert ratings call the race Solid or Safe Democratic, and prediction markets give Coons roughly a 98 to 99 percent chance of winning.\n\nThe race rests on fundamentals rather than polling, since no usable general-election surveys are available. Delaware's D+8 partisan lean, Coons's incumbency, and his overwhelming financial advantage all point toward a comfortable double-digit win. A September report about donations Coons received and redirected from an imprisoned contractor is the notable negative headline, but there is no evidence it has changed the race's basic trajectory.", "history": [{"date": "2026-09-22", "p_dem": 0.9941, "margin": 17.7}, {"date": "2026-09-23", "p_dem": 0.9931, "margin": 18.0}, {"date": "2026-09-24", "p_dem": 0.9927, "margin": 18.0}, {"date": "2026-09-25", "p_dem": 0.9906, "margin": 17.8}]}