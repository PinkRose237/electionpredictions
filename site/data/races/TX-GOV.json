icles/CBMie0FVX3lxTE9hODRYWHJEeG5sc2xtQkM1VzN6czZIZnhvNGM5MXhqQlBva1dBUmUtLUxoTEk0ZDhqQlJPcC1QVkE5dWxvMXdaMlRERW9ZYndKMUUwUlJ5S0N0anlVWkFxSHdxRXI3TWQxMU0zVzhWYU83bHp3dDJIWkwzUQ?oc=5"}, {"title": "Abbott, Hinojosa see shift in new 2026 Texas governor's race poll", "source": "El Paso Times", "published": "2026-09-16T19:42:00+00:00", "url": "https://news.google.?oc=5"}, {"title": "FILE -- Election Day: Government branches explained", "source": "FOX 7 Austin", "published": "2026-08-07T07:00:00+00:00", "url": "https://news.google.?oc=5"}], "model": {"prior_margin": -5.82, "prior_sd": 5.34, "poll_margin": -2.48, "poll_sd": 4.39, "poll_weight": 0.6, "fundamentals": {"margin": -5.29, "lean": -4.5, "environment": 3.95, "incumbency": -4.0, "money": -0.74}, "rating_margin": -6.17, "sigma_race": 5.5, "sigma_total": 5.96, "baseline_margin": -3.83, "analyst_adjustment": 0.33, "key_factors": ["Abbott's incumbency and massive cash advantage ($67M on hand vs $3M)", "Recent polls show a tighter-than-expected race, with one poll even giving Hinojosa a lead", "Texas's Republican-leaning fundamentals (PVI R+6) still favor the incumbent", "Prediction markets price Abbott around 70-75% despite the close polling"], "rationale": "The polling average sits around Abbott +2.5 to +3, notably tighter than the state's fundamentals and expert ratings imply, and recent surveys including a Marist poll show Hinojosa competitive or ahead. Still, Abbott's incumbency, fundraising dominance, and Texas's Republican lean justify keeping him favored by a few points.", "watch": "Whether the tight September polling holds through late October, or Abbott's spending advantage reopens a wider gap.", "confidence": "medium", "notes": ["Incumbent Greg Abbott (R) is running."]}, "overview": "Texas governor is closer than usual this cycle. Incumbent Greg Abbott faces state Representative Gina Hinojosa, who has emerged as his most competitive challenger in years. Polling through late September shows a race in the low single digits, with averages around Abbott plus two to three points, and at least one high-quality poll putting Hinojosa narrowly ahead. Headlines highlight property taxes and data-center opposition as live issues.\n\nAbbott still holds major structural advantages: a six-point Republican state lean, incumbency, and a fundraising edge of more than $60 million in cash on hand. Expert ratings mostly call the race Likely or Lean Republican, and prediction markets price Abbott's chances near 70 to 75 percent. The race is competitive but Abbott remains favored.", "history": [{"date": "2026-09-22", "p_dem": 0.1819, "margin": -4.27}, {"date": "2026-09-23", "p_dem": 0.2694, "margin": -3.5}]}