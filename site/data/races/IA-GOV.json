_sd": 4.79, "poll_weight": 0.55, "fundamentals": {"margin": -0.4, "lean": -4.5, "environment": 4.1, "incumbency": 0.0, "money": 0.0}, "rating_margin": 4.83, "sigma_race": 5.3, "sigma_total": 5.76, "baseline_margin": 5.71, "analyst_adjustment": -0.21, "key_factors": ["Sand leads in every recent poll, including Republican-sponsored surveys", "Open seat plus a favorable environment offsets Iowa's Republican lean", "Markets and most raters converge on a Democratic edge", "Third-party candidate and late attacks leave room for tightening"], "rationale": "September polling shows Sand ahead by four to twelve points, with even Republican-affiliated pollsters finding him in front, and prediction markets price his win odds in the low eighties. The open seat and a favorable environment outweigh Iowa's Republican lean, though the spread among pollsters keeps uncertainty elevated.", "watch": "If late-October polls tighten toward the low single digits or Republicans consolidate behind Lahn, the race could shift back toward tossup territory.", "confidence": "medium", "notes": ["Open seat: Kim Reynolds (R) is not on the ballot."]}, "overview": "Iowa's governorship is open for the first time since Kim Reynolds announced she would not seek another term, and State Auditor Rob Sand has turned the race into a genuine Democratic opportunity in a state that normally favors Republicans by about six points. Every poll since June shows Sand ahead of Republican Zach Lahn, with September surveys ranging from a four-point to a twelve-point lead, including results from Republican-affiliated pollsters. An independent candidate, Sondra Wilson, is also on the ballot.\n\nRaters and markets largely agree: four of six major ratings call the race a Democratic flip, and prediction markets put Sand's chances in the low eighties. Sand has campaigned heavily through a hundred-town-hall tour, while Republicans have attacked him as wealthy and out of touch. The race remains competitive in principle, but the weight of polling, ratings, and markets points to a modest Democratic edge.", "history": [{"date": "2026-09-22", "p_dem": 0.8753, "margin": 5.7}, {"date": "2026-09-23", "p_dem": 0.8859, "margin": 6.0}, {"date": "2026-09-24", "p_dem": 0.8669, "margin": 6.0}, {"date": "2026-09-25", "p_dem": 0.8657, "margin": 6.0}, {"date": "2026-09-26", "p_dem": 0.8472, "margin": 6.0}, {"date": "2026-09-27", "p_dem": 0.8297, "margin": 5.5}]}