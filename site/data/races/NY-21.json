en the mixed polling record.", "history": [{"date": "2026-09-22", "p_dem": 0.1406, "margin": -6.22}, {"date": "2026-09-23", "p_dem": 0.2036, "margin": -6.0}, {"date": "2026-09-24", "p_dem": 0.1958, "margin": -6.0}, {"date": "2026-09-25", "p_dem": 0.2007, "margin": -6.0}]}