or_sd": 5.34, "poll_margin": -12.07, "poll_sd": 5.87, "poll_weight": 0.45, "fundamentals": {"margin": 1.45, "lean": 1.5, "environment": 3.95, "incumbency": -4.0, "money": 0.0}, "rating_margin": -8.83, "sigma_race": 5.5, "sigma_total": 5.9, "baseline_margin": -8.05, "analyst_adjustment": -1.45, "key_factors": ["Incumbent Kelly Ayotte leads consistently in every 2026 poll, most recently by 10-21 points", "Expert ratings cluster at Likely or Lean Republican, with one rating Safe R", "Prediction markets price Warmington's chances at roughly 10 percent", "New Hampshire's slight Democratic lean is offset by incumbency advantages"], "rationale": "Every independent poll since spring shows Ayotte ahead by double digits, and the September co/efficient survey puts her up 21 among likely voters. Expert ratings and market pricing both point to a clear but not certain Republican hold, so a Likely R rating with a high-single-digit expected margin fits the evidence.", "watch": "A late debate stumble or a strong Warmington advertising push could narrow a double-digit polling gap in a state that has historically swung quickly.", "confidence": "medium", "notes": ["Incumbent Kelly Ayotte (R) is running."]}, "overview": "Incumbent Republican Governor Kelly Ayotte faces Democratic nominee Cinde Warmington after easily winning her September primary. Polling has been remarkably consistent all year: University of New Hampshire and Saint Anselm surveys showed Ayotte ahead by five to ten points through the summer, and the gap widened after the primary, with a September co/efficient poll showing a 21-point lead. Averages of published forecasts put the race around 14 points Republican.\n\nRaters broadly call the race Likely Republican, with one rating it Safe Republican, and prediction markets give Warmington only about a one-in-ten chance. New Hampshire's mild Democratic lean and the state's history of close governor's races keep some uncertainty in the picture, but the incumbent's steady polling lead and unified post-primary position make her a clear favorite heading into November.", "history": [{"date": "2026-09-22", "p_dem": 0.0651, "margin": -8.09}, {"date": "2026-09-23", "p_dem": 0.0538, "margin": -9.5}]}