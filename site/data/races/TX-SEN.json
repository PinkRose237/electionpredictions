icles/CBMikwFBVV95cUxPaWJnOHV2MnFrSjVzMEp6MGJkUmZsZjc0N2ZKUmMwWXFyTkpfdWU2QlRPNHU1SWNZNUhxNzloRzNnaC1vZXNGLUVHMm5uZXRVZVJud3hIcXhJZTUtZGNJQmIyZ3hlZEQyU2lBZEYzMXByMWp0czZ5MDhTb2hOZTYyMDVhRVFlc1FxdTk4a3hLZU5CODQ?oc=5"}, {"title": "Talarico Leads Paxton in Texas Senate Race · Oct 14, 2026", "source": "ActiVote", "published": "2026-10-14T07:00:00+00:00", "url": "https://news.google.com/rss/articles/CBMibkFVX3lxTE04dy1EY0FLZVMwLVdoYVpOQVhYck1GTTdaNXdMNjZrRWNSMEZmMU9iUEczQkk5b1lBQ1BOZEpHNFVkNzV3STNQenhEM1kteHUwVkw5LVFsRWhVTjhSQ0FBZ1JWa2tvdzdPOWs1U2pB?oc=5"}], "model": {"prior_margin": 1.54, "prior_sd": 5.0, "poll_margin": 3.12, "poll_sd": 4.28, "poll_weight": 0.58, "fundamentals": {"margin": 2.36, "lean": -6.0, "environment": 7.38, "incumbency": 0.0, "money": 0.98}, "rating_margin": 1.0, "sigma_race": 5.0, "sigma_total": 5.72, "baseline_margin": 2.46, "analyst_adjustment": -0.36, "key_factors": ["October polls from independent and partisan firms consistently show Talarico ahead by 2-6 points in a state that has leaned Republican", "Talarico holds a record $68.6 million fundraising haul and large cash advantage, while Paxton has drawn roughly $27 million in outside opposition", "Nearly all expert raters call it a Tossup and prediction markets price a modest Democratic edge around 60 percent", "Talarico's lead has narrowed late, with controversy over past remarks on religion and gender"], "rationale": "Polls across the ideological spectrum, including high-quality surveyors, consistently give Talarico a small lead in a Republican-leaning open-seat state, reinforced by his massive fundraising edge and the heavy outside spending against Paxton. With most raters still calling the race a Tossup and recent polling showing the lead narrowing, the forecast sits at the low end of Lean D.", "watch": "Deeper fallout from Talarico's walked-back comments on religion and gender, or a turnout pattern that diverges from recent polling assumptions, could flip this narrow edge.", "confidence": "medium", "notes": ["Open seat: John Cornyn (R) is not on the ballot."]}, "overview": "Texas's Senate race is an open-seat contest between Democratic state representative James Talarico and Republican Attorney General Ken Paxton after Senator John Cornyn lost renomination. October polling from a wide range of firms shows Talarico ahead by roughly two to six points, with published averages around three points, in a state that has recently leaned Republican by about six. Expert raters overwhelmingly call the race a Tossup, two rate it a narrow Democratic edge, and prediction markets price Talarico's chances near 60 percent.\n\nTalarico has raised a record $68.6 million and holds a substantial cash advantage, while Paxton has drawn about $27 million in outside opposition advertising; more than $500 million has been spent statewide. Talarico's lead has narrowed in recent days and he has faced pointed questions over past remarks, keeping the contest genuinely tight entering the final stretch.", "history": [{"date": "2026-09-22", "p_dem": 0.6697, "margin": 2.08}, {"date": "2026-09-23", "p_dem": 0.6924, "margin": 2.5}, {"date": "2026-09-24", "p_dem": 0.7255, "margin": 2.8}, {"date": "2026-09-25", "p_dem": 0.6997, "margin": 2.5}, {"date": "2026-09-26", "p_dem": 0.6523, "margin": 2.5}, {"date": "2026-09-27", "p_dem": 0.6444, "margin": 2.5}, {"date": "2026-09-28", "p_dem": 0.6983, "margin": 2.5}, {"date": "2026-09-29", "p_dem": 0.7151, "margin": 2.5}, {"date": "2026-09-30", "p_dem": 0.701, "margin": 2.5}, {"date": "2026-10-01", "p_dem": 0.7008, "margin": 2.5}, {"date": "2026-10-02", "p_dem": 0.6832, "margin": 2.2}, {"date": "2026-10-03", "p_dem": 0.7125, "margin": 2.5}, {"date": "2026-10-04", "p_dem": 0.7022, "margin": 2.5}, {"date": "2026-10-05", "p_dem": 0.6597, "margin": 2.6}, {"date": "2026-10-06", "p_dem": 0.6724, "margin": 2.8}, {"date": "2026-10-07", "p_dem": 0.6815, "margin": 3.0}, {"date": "2026-10-08", "p_dem": 0.6849, "margin": 2.5}, {"date": "2026-10-09", "p_de