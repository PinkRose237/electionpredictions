allot House races.", "history": [{"date": "2026-09-22", "p_dem": 0.9859, "margin": 12.77}, {"date": "2026-09-23", "p_dem": 0.9584, "margin": 9.0}, {"date": "2026-09-24", "p_dem": 0.9776, "margin": 12.0}, {"date": "2026-09-25", "p_dem": 0.9779, "margin": 12.0}, {"date": "2026-09-26", "p_dem": 0.9761, "margin": 12.0}, {"date": "2026-09-27", "p_dem": 0.9756, "margin": 12.0}, {"date": "2026-09-28", "p_dem": 0.9778, "margin": 12.0}, {"date": "2026-09-29", "p_dem": 0.9755, "margin": 11.5}, {"date": "2026-09-30", "p_dem": 0.9799, "margin": 12.5}, {"date": "2026-10-01", "p_dem": 0.9796, "margin": 12.0}]}