del": {"prior_margin": 14.1, "prior_sd": 5.34, "poll_margin": 12.74, "poll_sd": 5.53, "poll_weight": 0.48, "fundamentals": {"margin": 14.26, "lean": 6.0, "environment": 4.15, "incumbency": 4.0, "money": 0.11}, "rating_margin": 14.0, "sigma_race": 5.5, "sigma_total": 5.91, "baseline_margin": 13.45, "analyst_adjustment": -0.95, "key_factors": ["Hochul has led every poll this cycle, with the latest high-quality surveys showing 9- and 19-point leads among likely voters", "Expert raters uniformly call the race Safe or Solid D, and prediction markets price Democratic chances around 95 percent", "D+8 state fundamentals, incumbency, and a favorable environment point to a double-digit Democratic edge", "Blakeman's fundraising is competitive, but sparse policy detail and matching-funds questions limit his case"], "rationale": "Every poll this cycle shows Hochul ahead, with the two most recent high-quality surveys at nine and nineteen points, and raters and prediction markets agree the race is safely Democratic. Blakeman has kept pace financially, but the state's Democratic lean and a favorable environment leave him little evident path to close the gap.", "watch": "A late Trump appearance boosting Blakeman's turnout, or backlash from Mamdani's joint campaigning with Hochul, could tighten the margin in the final weeks.", "confidence": "high", "notes": ["Incumbent Kathy Hochul (D) is running."]}, "overview": "New York's governor race pits incumbent Democrat Kathy Hochul against Republican nominee Bruce Blakeman. Polling has consistently favored Hochul all year, with every survey this cycle showing her ahead; the two most recent high-quality polls put her lead at nine and nineteen points among likely voters. Election raters across the spectrum call the race solidly or safely Democratic, and prediction markets price her chances around 95 percent.\n\nBlakeman has run a competitive fundraising operation, bringing in over $13 million, and has pitched income tax cuts and a new Staten Island bridge while President Trump plans to campaign with him. But he has offered few detailed policies and faces questions over ineligible matching-fund donations. Hochul, armed with a large war chest in a Democratic-leaning state, holds a clear advantage heading into the final stretch, with cost of living and the economy topping voters' concerns.", "history": [{"date": "2026-09-22", "p_dem": 0.9859, "margin": 12.77}, {"date": "2026-09-23", "p_dem": 0.9584, "margin": 9.0}, {"date": "2026-09-24", "p_dem": 0.9776, "margin": 12.0}, {"date": "2026-09-25", "p_dem": 0.9779, "margin": 12.0}, {"date": "2026-09-26", "p_dem": 0.9761, "margin": 12.0}, {"date": "2026-09-27", "p_dem": 0.9756, "margin": 12.0}, {"date": "2026-09-28", "p_dem": 0.9778, "margin": 12.0}, {"date": "2026-09-29", "p_dem": 0.9755, "margin": 11.5}, {"date": "2026-09-30", "p_dem": 0.9799, "margin": 12.5}, {"date": "2026-10-01", "p_dem": 0.9796, "margin": 12.0}, {"date": "2026-10-02", "p_dem": 0.9804, "margin": 12.0}, {"date": "2026-10-03", "p_dem": 0.9807, "margin": 12.5}, {"date": "2026-10-04", "p_dem": 0.9805, "margin": 12.5}]}