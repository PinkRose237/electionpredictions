icles/CBMiqwFBVV95cUxNWVJwVldCdi1tSUo3Q0dRWVhWZWkyeWJHWDluem9YWDlCbWluQ2JOMWZKbWZfTk1ZV19mb1ZrQVkzTEJNMUQyUFFVZTVRd1N6WXlJYVVGS1BZWGhUUXVqR05QYlJFY3RzaTZDN2plUi04bXFiTHp6X2U2dWFjNGlIRGR0a0dMV0NiRXYwMWJrOWxYbV92bEhFNXlMckJCNEx0SVU4QlFMUW9mTDg?oc=5"}, {"title": "Titus faces three primary challengers as she seeks her eighth term in CD1", "source": "Nevada Current", "published": "2026-04-29T07:00:00+00:00", "url": "https://news.google.com/rss/articles/CBMisAFBVV95cUxQak1ScFdUT3piOU1IWXRVSjhRNFBvMC11UHcydWpvamk0YVdfSW5CMkd6QUMtdXVMSEhZbG5WbXV1QnNWSFBjZ3p2N2I0N0w0VmlQaF9Ubk1kYzF6TWlZTHlwVHN4cWxQblpkQTl1dXdKQ3daM3dXMHNiWm5RdWRjbUk1ZlZoYl9aMlNNZHZfeHhqeF9IV0JjQnBEWHVfcmp0dDkzd0hTVmt4N2VtVmxjZA?oc=5"}], "model": {"prior_margin": 11.82, "prior_sd": 5.11, "poll_margin": null, "poll_sd": null, "poll_weight": 0.0, "fundamentals": {"margin": 12.06, "lean": 2.0, "environment": 8.2, "incumbency": 2.0, "money": -0.14}, "rating_margin": 11.67, "sigma_race": 6.5, "sigma_total": 7.26, "baseline_margin": 11.82, "analyst_adjustment": -0.82, "key_factors": ["D+2 district with incumbent Dina Titus seeking reelection", "Expert consensus at Likely D, with markets pricing Titus around 93-94%", "Carrie Buck is a well-funded, credible challenger who has raised $1.9M", "No public general-election polling in the race"], "rationale": "The fundamentals point to a comfortable but not safe Titus win: a D+2 seat, incumbency, a favorable national environment for Democrats, and a Likely D consensus among raters, with markets at 93-94%. Buck's strong fundraising and the Inside Elections Lean D rating justify trimming the expected margin slightly, but not enough to move the race category.", "watch": "Any credible general-election polling showing Buck within single digits, or heavy outside spending on her behalf, would move this toward Tossup.", "confidence": "medium", "notes": ["No usable general-election polls; forecast rests on fundamentals and expert ratings.", "Incumbent Dina Titus (D) is running."]}, "overview": "Dina Titus is seeking another term in a Las Vegas-area district that leans Democratic by about two points. Forecasters broadly rate the race Likely Democratic, though Inside Elections sees it as Lean Democratic, and prediction markets give Titus roughly a 93-94% chance of winning. No public general-election polls are available, so the outlook rests on fundamentals and expert judgment.\n\nRepublicans nominated Carrie Buck, a strong fundraiser who has out-raised Titus in raw dollars, though Titus holds a cash-on-hand edge and Democrats enjoy a broader money advantage in Southern Nevada. Buck is viewed as a serious recruit, and GOP hopes tie partly to the 'no tax on tips' issue in a hospitality-heavy district. Still, the combination of incumbency, district lean, and the national environment keeps Titus clearly favored, with a modest chance of a closer-than-expected finish.", "history": [{"date": "2026-09-22", "p_dem": 0.9567, "margin": 11.7}, {"date": "2026-09-23", "p_dem": 0.9528, "margin": 11.5}, {"date": "2026-09-24", "p_dem": 0.9532, "margin": 11.5}, {"date": "2026-09-25", "p_dem": 0.9485, "margin": 11.0}, {"date": "2026-09-26", "p_dem": 0.9322, "margin": 11.0}, {"date": "2026-09-27", "p_dem": 0.9231, "margin": 10.5}, {"date": "2026-09-28", "p_dem": 0.9459, "margin": 11.0}]}