ns Democratic with elevated uncertainty.", "history": [{"date": "2026-09-22", "p_dem": 0.7982, "margin": 5.28}, {"date": "2026-09-23", "p_dem": 0.8298, "margin": 6.0}, {"date": "2026-09-24", "p_dem": 0.8404, "margin": 6.5}, {"date": "2026-09-25", "p_dem": 0.8532, "margin": 6.5}, {"date": "2026-09-26", "p_dem": 0.8134, "margin": 6.5}, {"date": "2026-09-27", "p_dem": 0.7945, "margin": 6.0}, {"date": "2026-09-28", "p_dem": 0.8475, "margin": 6.5}, {"date": "2026-09-29", "p_dem": 0.8189, "margin": 5.5}, {"date": "2026-09-30", "p_dem": 0.8075, "margin": 5.5}, {"date": "2026-10-01", "p_dem": 0.8433, "margin": 6.2}, {"date": "2026-10-02", "p_dem": 0.8577, "margin": 6.5}]}