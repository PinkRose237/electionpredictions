sd": 5.34, "poll_margin": 19.56, "poll_sd": 7.1, "poll_weight": 0.36, "fundamentals": {"margin": 18.6, "lean": 10.5, "environment": 4.1, "incumbency": 4.0, "money": 0.0}, "rating_margin": 16.0, "sigma_race": 5.5, "sigma_total": 5.91, "baseline_margin": 17.95, "analyst_adjustment": 0.05, "key_factors": ["D+14 state with a popular incumbent; all seven expert raters call it Solid or Safe D", "Every recent poll shows Healey up 16-24 points, and outside averages sit near +20", "Prediction markets price Healey around 95-96%, leaving a small residual tail risk", "Final-debate clashes over energy costs and a fired state worker have not moved polling"], "rationale": "Polling from spring through late September uniformly gives Healey a double-digit lead among likely voters in a heavily Democratic state, and every professional rater places the race in the safest Democratic category. Incumbency, the state's partisan lean, and consistent survey results outweigh any late debate friction.", "watch": "Any post-debate survey showing Minogue within single digits, or the LaMar Cook state-worker scandal expanding into a broader administration controversy, would warrant revisiting the margin.", "confidence": "high", "notes": ["Incumbent Maura Healey (D) is running."]}, "overview": "Maura Healey enters the final weeks seeking a second term in one of the nation's most Democratic states, and every measurable indicator points her way. Polls from June through late September uniformly show her ahead of Mike Minogue by roughly sixteen to twenty-four points among likely voters, and outside averages put the race near a twenty-point margin. All seven professional ratings list the contest as Solid or Safe Democratic.\n\nMinogue has kept the race competitive in tone; mid-October debates produced sharp exchanges over energy costs, affordability and a fired state employee, and fact-checkers reviewed the claims closely. Still, no public survey has shown the gap narrowing toward single digits, and betting markets give Healey roughly a 95 percent chance, only slightly more cautious than the polls. Given the state's partisan lean and the incumbent's standing, an upset would require a major, unforeseen shift.", "history": [{"date": "2026-09-22", "p_dem": 0.9961, "margin": 18.83}, {"date": "2026-09-23", "p_dem": 0.9968, "margin": 20.0}, {"date": "2026-09-24", "p_dem": 0.9983, "margin": 21.0}, {"date": "2026-09-25", "p_dem": 0.9947, "margin": 17.5}, {"date": "2026-09-26", "p_dem": 0.9929, "margin": 17.5}, {"date": "2026-09-27", "p_dem": 0.9875, "margin": 17.0}, {"date": "2026-09-28", "p_dem": 0.9913, "margin": 17.0}, {"date": "2026-09-29", "p_dem": 0.9921, "margin": 17.0}, {"date": "2026-09-30", "p_dem": 0.9908, "margin": 17.0}, {"date": "2026-10-01", "p_dem": 0.996, "margin": 18.5}, {"date": "2026-10-02", "p_dem": 0.9953, "margin": 18.5}, {"date": "2026-10-03", "p_dem": 0.9946, "margin": 18.5}, {"date": "2026-10-04", "p_dem": 0.996, "margin": 18.0}, {"date": "2026-10-05", "p_dem": 0.9924, "margin": 18.0}, {"date": "2026-10-06", "p_dem": 0.9932, "margin": 18.5}, {"date": "2026-10-07", "p_dem": 0.9949, "margin": 18.5}, {"date": "2026-10-08", "p_dem": 0.9959, "margin": 19.0}, {"date": "2026-10-09", "p_dem": 0.9955, "margin": 18.5}, {"date": "2026-10-10", "p_dem": 0.996, "margin": 18.5}, {"date": "2026-10-11", "p_dem": 0.9967, "margin": 19.0}, {"date": "2026-10-12", "p_dem": 0.9976, "margin": 19.0}, {"date": "2026-10-13", "p_dem": 0.9979, "margin": 19.0}, {"date": "2026-10-14", "p_dem": 0.9952, "margin": 19.5}, {"date": "2026-10-15", "p_dem": 0.9974, "margin": 19.0}, {"date": "2026-10-16", "p_dem": 0.9923, "margin": 18.0}, {"date": "2026-10-17", "p_dem": 0.994, "margin": 18.0}]}