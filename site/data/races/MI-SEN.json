margin": 7.93, "lean": 0.0, "environment": 7.83, "incumbency": 0.0, "money": 0.1}, "rating_margin": 3.77, "sigma_race": 5.0, "sigma_total": 5.67, "baseline_margin": 4.38, "analyst_adjustment": -0.98, "key_factors": ["Polls through late October consistently show El-Sayed ahead by two to five points, including Republican-sponsored surveys", "Most expert raters call the race Lean Democratic, with fundamentals favoring Democrats in this open seat", "Heavy Republican outside spending against El-Sayed and final-week Trump and Vance rallies keep Rogers competitive", "Prediction markets price El-Sayed's win chances near 69 percent"], "rationale": "Polling across the final weeks shows El-Sayed leading by two to five points, even in Republican-affiliated surveys, and most raters place the race at Lean Democratic. Heavy GOP outside spending and last-week Trump and Vance rallies keep Rogers within striking distance, but the consistent polling edge and a favorable environment point to a modest Democratic advantage.", "watch": "A late shift toward Rogers driven by Trump's attacks and Republican advertising, or movement among Arab American and Jewish voters, could turn this into a true tossup.", "confidence": "medium", "notes": ["Open seat: Gary Peters (D) is not on the ballot."]}, "overview": "Michigan's open Senate seat pits Democrat Abdul El-Sayed against Republican Mike Rogers to succeed retiring Senator Gary Peters. Polling through late October consistently shows El-Sayed ahead by roughly two to five points, including surveys from Republican-affiliated pollsters, and most expert raters call the race Lean Democratic, though Cook and others rate it a Tossup. Prediction markets give El-Sayed about a 69 percent chance of winning.\n\nEl-Sayed has raised more than twice Rogers' total, but Republican outside groups have poured roughly $21 million into attacks on him, and Trump and JD Vance have campaigned in the state in the final week. The contest has been shaped by disputes over loyalty and by Trump's attacks on El-Sayed, which have split Arab American and Jewish communities. The race remains competitive but tilts Democratic heading into Election Day.", "history": [{"date": "2026-09-22", "p_dem": 0.7769, "margin": 3.59}, {"date": "2026-09-23", "p_dem": 0.7646, "margin": 3.5}, {"date": "2026-09-24", "p_dem": 0.7534, "margin": 3.2}, {"date": "2026-09-25", "p_dem": 0.7553, "margin": 3.4}, {"date": "2026-09-26", "p_dem": 0.6955, "margin": 3.2}, {"date": "2026-09-27", "p_dem": 0.7118, "margin": 3.5}, {"date": "2026-09-28", "p_dem": 0.7565, "margin": 3.5}, {"date": "2026-09-29", "p_dem": 0.7778, "margin": 3.5}, {"date": "2026-09-30", "p_dem": 0.755, "margin": 3.5}, {"date": "2026-10-01", "p_dem": 0.7606, "margin": 3.5}, {"date": "2026-10-02", "p_dem": 0.7617, "margin": 3.5}, {"date": "2026-10-03", "p_dem": 0.7781, "margin": 3.5}, {"date": "2026-10-04", "p_dem": 0.7877, "margin": 3.7}, {"date": "2026-10-05", "p_dem": 0.7047, "margin": 3.5}, {"date": "2026-10-06", "p_dem": 0.7427, "margin": 4.0}, {"date": "2026-10-07", "p_dem": 0.7248, "margin": 3.5}, {"date": "2026-10-08", "p_dem": 0.7315, "margin": 3.2}, {"date": "2026-10-09", "p_dem": 0.7258, "margin": 3.5}, {"date": "2026-10-10", "p_dem": 0.7248, "margin": 3.5}, {"date": "2026-10-11", "p_dem": 0.7308, "margin": 3.5}, {"date": "2026-10-12", "p_dem": 0.7776, "margin": 3.5}, {"date": "2026-10-13", "p_dem": 0.7463, "margin": 3.5}, {"date": "2026-10-14", "p_dem": 0.751, "margin": 3.5}, {"date": "2026-10-15", "p_dem": 0.7235, "margin": 3.6}, {"date": "2026-10-16", "p_dem": 0.7121, "margin": 3.5}, {"date": "2026-10-17", "p_dem": 0.6865, "margin": 3.0}, {"date": "2026-10-18", "p_dem": 0.6907, "margin": 3.0}, {"date": "2026-10-19", "p_dem": 0.6744, "margin": 3.0}, {"date": "2026-10-20", "p_dem": 0.7022, "margin": 3.2}, {"date": "2026-10-21", "p_dem": 0.7063, "margin": 3.2}, {"date": "2026-10-22", "p_dem": 0.7722, "margin": 3.2}, {"date": "2026-10-23", "p_dem": 0.7208, "margin": 3.0}, {"date": "2026-10-24