argin": 5.49, "prior_sd": 5.11, "poll_margin": 5.0, "poll_sd": 11.77, "poll_weight": 0.16, "fundamentals": {"margin": 5.4, "lean": -1.0, "environment": 8.2, "incumbency": -2.0, "money": 0.2}, "rating_margin": 5.55, "sigma_race": 5.9, "sigma_total": 6.69, "baseline_margin": 5.41, "analyst_adjustment": -0.01, "key_factors": ["Unanimous expert ratings: all ten raters call PA-07 a Democratic flip, mostly at Lean D", "Prediction markets price Brooks at roughly 80-86 percent to win", "September Franklin & Marshall poll shows Brooks ahead 45-40 in a district that is near-even on partisanship", "Fundraising is close; Brooks edges on outside support while incumbent Mackenzie holds the cash-on-hand lead"], "rationale": "Every race rater calls this a Democratic flip and betting markets price Brooks near 85 percent, while the lone recent independent poll gives him a five-point lead. Mackenzie's incumbency and cash edge keep the race competitive, but a near-even district and a Democratic-favoring environment point to a modest Brooks margin.", "watch": "Fresh polling or a successful Mackenzie economic appeal to Latino and working-class voters could tighten the race back toward a tossup.", "confidence": "medium", "notes": ["Incumbent Ryan Mackenzie (R) is running."]}, "overview": "Pennsylvania's 7th is a Lehigh Valley contest between first-term Republican incumbent Ryan Mackenzie and Democratic challenger Bob Brooks in a district that is nearly even on partisanship. Every major race rating published this fall calls the seat a Democratic flip, most at Lean D, and betting markets give Brooks roughly an 80-86 percent chance of winning. A September Franklin & Marshall poll of registered voters put Brooks ahead 45 to 40.\n\nThe money race is close. Mackenzie has the larger warchest, but Brooks has kept pace in fundraising and holds a clear edge in outside spending on his side. Coverage has turned harsh and personal, and reporting highlights economic unease among Latino voters, a constituency that backed Trump here. With polling thin but signals converging, the race leans Democratic, though real uncertainty remains.", "history": [{"date": "2026-09-22", "p_dem": 0.7234, "margin": 3.52}, {"date": "2026-09-23", "p_dem": 0.7148, "margin": 3.0}, {"date": "2026-09-24", "p_dem": 0.7673, "margin": 4.0}, {"date": "2026-09-25", "p_dem": 0.7925, "margin": 4.5}, {"date": "2026-09-26", "p_dem": 0.7174, "margin": 4.0}, {"date": "2026-09-27", "p_dem": 0.7271, "margin": 4.2}, {"date": "2026-09-28", "p_dem": 0.7743, "margin": 4.0}, {"date": "2026-09-29", "p_dem": 0.7833, "margin": 4.2}, {"date": "2026-09-30", "p_dem": 0.8054, "margin": 5.0}, {"date": "2026-10-01", "p_dem": 0.794, "margin": 4.5}, {"date": "2026-10-02", "p_dem": 0.7967, "margin": 4.5}, {"date": "2026-10-03", "p_dem": 0.7964, "margin": 4.5}, {"date": "2026-10-04", "p_dem": 0.8131, "margin": 4.8}, {"date": "2026-10-05", "p_dem": 0.7441, "margin": 4.5}, {"date": "2026-10-06", "p_dem": 0.7281, "margin": 4.2}, {"date": "2026-10-07", "p_dem": 0.7654, "margin": 5.0}, {"date": "2026-10-08", "p_dem": 0.8097, "margin": 5.0}, {"date": "2026-10-09", "p_dem": 0.7721, "margin": 5.0}, {"date": "2026-10-10", "p_dem": 0.7706, "margin": 5.0}, {"date": "2026-10-11", "p_dem": 0.7848, "margin": 5.0}, {"date": "2026-10-12", "p_dem": 0.7941, "margin": 4.5}, {"date": "2026-10-13", "p_dem": 0.7922, "margin": 5.0}, {"date": "2026-10-14", "p_dem": 0.8172, "margin": 5.5}, {"date": "2026-10-15", "p_dem": 0.7927, "margin": 5.5}, {"date": "2026-10-16", "p_dem": 0.7904, "margin": 5.4}]}