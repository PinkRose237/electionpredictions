unu's name recognition keep this from being out of reach for Republicans.", "history": [{"date": "2026-09-22", "p_dem": 0.8721, "margin": 5.76}, {"date": "2026-09-23", "p_dem": 0.8221, "margin": 5.0}, {"date": "2026-09-24", "p_dem": 0.7959, "margin": 4.5}, {"date": "2026-09-25", "p_dem": 0.8661, "margin": 6.0}, {"date": "2026-09-26", "p_dem": 0.8028, "margin": 5.5}, {"date": "2026-09-27", "p_dem": 0.837, "margin": 6.0}, {"date": "2026-09-28", "p_dem": 0.8746, "margin": 6.5}, {"date": "2026-09-29", "p_dem": 0.8609, "margin": 6.0}, {"date": "2026-09-30", "p_dem": 0.856, "margin": 6.0}, {"date": "2026-10-01", "p_dem": 0.8659, "margin": 6.0}, {"date": "2026-10-02", "p_dem": 0.8767, "margin": 6.0}, {"date": "2026-10-03", "p_dem": 0.8474, "margin": 5.5}, {"date": "2026-10-04", "p_dem": 0.8665, "margin": 5.8}, {"date": "2026-10-05", "p_dem": 0.841, "margin": 6.0}, {"date": "2026-10-06", "p_dem": 0.8206, "margin": 5.5}, {"date": "2026-10-07", "p_dem": 0.8623, "margin": 6.5}, {"date": "2026-10-08", "p_dem": 0.8967, "margin": 7.0}, {"date": "2026-10-09", "p_dem": 0.8462, "margin": 6.5}, {"date": "2026-10-10", "p_dem": 0.8579, "margin": 6.5}, {"date": "2026-10-11", "p_dem": 0.8632, "margin": 6.5}, {"date": "2026-10-12", "p_dem": 0.8916, "margin": 6.5}, {"date": "2026-10-13", "p_dem": 0.8732, "margin": 6.5}, {"date": "2026-10-14", "p_dem": 0.8802, "margin": 6.8}, {"date": "2026-10-15", "p_dem": 0.8587, "margin": 6.5}, {"date": "2026-10-16", "p_dem": 0.8485, "margin": 6.5}, {"date": "2026-10-17", "p_dem": 0.886, "margin": 7.0}, {"date": "2026-10-18", "p_dem": 0.8784, "margin": 6.8}, {"date": "2026-10-19", "p_dem": 0.869, "margin": 6.8}, {"date": "2026-10-20", "p_dem": 0.8691, "margin": 6.8}, {"date": "2026-10-21", "p_dem": 0.8823, "margin": 7.0}, {"date": "2026-10-22", "p_dem": 0.9123, "margin": 7.0}, {"date": "2026-10-23", "p_dem": 0.8943, "margin": 7.0}, {"date": "2026-10-24", "p_dem": 0.8798, "margin": 7.0}, {"date": "2026-10-25", "p_dem": 0.8806, "margin": 7.0}, {"date": "20