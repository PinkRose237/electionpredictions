": 0.54, "fundamentals": {"margin": 8.82, "lean": 4.0, "environment": 7.83, "incumbency": -3.0, "money": -0.01}, "rating_margin": 2.27, "sigma_race": 5.0, "sigma_total": 5.69, "baseline_margin": 3.55, "analyst_adjustment": -1.05, "key_factors": ["Polling average shows Jackson narrowly ahead (~2 points) across high- and low-quality pollsters", "Expert ratings split between Tossup and Lean D, with several late flips toward Democrats", "Prediction markets price Jackson at roughly 66%, more bullish than polls alone justify", "Collins's incumbency and fundraising are offset by a favorable Democratic state lean and national environment"], "rationale": "Polls consistently show Jackson up by about two points, and late ratings from several outlets moved to Lean D, though many still call it a Tossup. Markets price Jackson near two-to-one, but the thin polling edge and Collins's incumbent resilience argue for a modest Democratic edge rather than more.", "watch": "A late shift among independents on the tariff issue, or a strong Collins debate bounce, could tighten this back into a true tossup.", "confidence": "medium", "notes": ["Incumbent Susan Collins (R) is running."]}, "overview": "Maine's Senate race pits five-term incumbent Susan Collins against Maine Senate President Troy Jackson in one of the cycle's most expensive contests. Polling throughout October has been remarkably consistent, with nearly every survey showing Jackson ahead by two to four points, including work from high-quality pollsters like Suffolk, Marist, and the Washington Post. Collins has leaned on her independent brand, even bringing former Democratic senator Joe Manchin to campaign alongside her, while Jackson has drawn surrogate help from Alexandria Ocasio-Cortez and attacks on Trump-era tariffs that weigh on Maine's economy.\n\nExpert raters remain divided, with most calling the race a Tossup but several recent ratings moving to Lean D. Prediction markets give Jackson roughly a two-thirds chance, somewhat rosier than the polling alone. With heavy negative spending on both sides and Maine's slow vote count, the race looks like a narrow Democratic edge that could take weeks to resolve.", "history": [{"date": "2026-09-22", "p_dem": 0.7341, "margin": 3.16}, {"date": "2026-09-23", "p_dem": 0.6906, "margin": 2.5}, {"date": "2026-09-24", "p_dem": 0.626, "margin": 1.5}, {"date": "2026-09-25", "p_dem": 0.6915, "margin": 2.5}, {"date": "2026-09-26", "p_dem": 0.5751, "margin": 1.5}, {"date": "2026-09-27", "p_dem": 0.6364, "margin": 2.5}, {"date": "2026-09-28", "p_dem": 0.6474, "margin": 2.0}, {"date": "2026-09-29", "p_dem": 0.6668, "margin": 2.0}, {"date": "2026-09-30", "p_dem": 0.6495, "margin": 2.0}, {"date": "2026-10-01", "p_dem": 0.6328, "margin": 1.5}, {"date": "2026-10-02", "p_dem": 0.6994, "margin": 2.5}, {"date": "2026-10-03", "p_dem": 0.6388, "margin": 1.5}, {"date": "2026-10-04", "p_dem": 0.6279, "margin": 1.5}, {"date": "2026-10-05", "p_dem": 0.5727, "margin": 1.5}, {"date": "2026-10-06", "p_dem": 0.6061, "margin": 2.0}, {"date": "2026-10-07", "p_dem": 0.6059, "margin": 2.0}, {"date": "2026-10-08", "p_dem": 0.6373, "margin": 2.0}, {"date": "2026-10-09", "p_dem": 0.6384, "margin": 2.5}, {"date": "2026-10-10", "p_dem": 0.6413, "margin": 2.5}, {"date": "2026-10-11", "p_dem": 0.6281, "margin": 2.2}, {"date": "2026-10-12", "p_dem": 0.7044, "margin": 2.5}, {"date": "2026-10-13", "p_dem": 0.6795, "margin": 2.5}, {"date": "2026-10-14", "p_dem": 0.6677, "margin": 2.5}, {"date": "2026-10-15", "p_dem": 0.6481, "margin": 2.5}, {"date": "2026-10-16", "p_dem": 0.64, "margin": 2.5}, {"date": "2026-10-17", "p_dem": 0.649, "margin": 2.5}, {"date": "2026-10-18", "p_dem": 0.6509, "margin": 2.5}, {"date": "2026-10-19", "p_dem": 0.6481, "margin": 2.5}, {"date": "2026-10-20", "p_dem": 0.6507, "margin": 2.5}, {"date": "2026-10-21", "p_dem": 0.6449, "margin": 2.5}, {"date": "2026-10-22", "p_dem": 0.71, "margin": 2.5}]}