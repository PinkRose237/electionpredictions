ers call it a tossup, with one rating it a Democratic flip.", "history": [{"date": "2026-09-22", "p_dem": 0.545, "margin": 0.49}, {"date": "2026-09-23", "p_dem": 0.5929, "margin": 1.0}, {"date": "2026-09-24", "p_dem": 0.5919, "margin": 1.0}, {"date": "2026-09-25", "p_dem": 0.6166, "margin": 1.3}, {"date": "2026-09-26", "p_dem": 0.5684, "margin": 1.2}, {"date": "2026-09-27", "p_dem": 0.592, "margin": 1.4}, {"date": "2026-09-28", "p_dem": 0.6233, "margin": 1.5}, {"date": "2026-09-29", "p_dem": 0.6597, "margin": 2.0}, {"date": "2026-09-30", "p_dem": 0.662, "margin": 2.0}, {"date": "2026-10-01", "p_dem": 0.6672, "margin": 2.0}, {"date": "2026-10-02", "p_dem": 0.6954, "margin": 2.5}, {"date": "2026-10-03", "p_dem": 0.6965, "margin": 2.5}, {"date": "2026-10-04", "p_dem": 0.7208, "margin": 2.7}, {"date": "2026-10-05", "p_dem": 0.6724, "margin": 2.5}, {"date": "2026-10-06", "p_dem": 0.6809, "margin": 2.7}, {"date": "2026-10-07", "p_dem": 0.7082, "margin": 3.0}, {"date": "2026-10-08", "p_dem": 0.7607, "margin": 3.5}, {"date": "2026-10-09", "p_dem": 0.7343, "margin": 3.5}, {"date": "2026-10-10", "p_dem": 0.7436, "margin": 3.5}, {"date": "2026-10-11", "p_dem": 0.7448, "margin": 3.5}, {"date": "2026-10-12", "p_dem": 0.7476, "margin": 3.0}, {"date": "2026-10-13", "p_dem": 0.6888, "margin": 2.5}, {"date": "2026-10-14", "p_dem": 0.6987, "margin": 2.7}]}