or_sd": 5.34, "poll_margin": null, "poll_sd": null, "poll_weight": 0.0, "fundamentals": {"margin": 8.6, "lean": 4.5, "environment": 4.1, "incumbency": 0.0, "money": 0.0}, "rating_margin": 14.83, "sigma_race": 6.5, "sigma_total": 6.88, "baseline_margin": 12.34, "analyst_adjustment": 0.16, "key_factors": ["Colorado's D+6 partisan lean and Democratic strength in statewide races favor Weiser in the open seat", "All six expert raters score the race Solid or Safe D, and prediction markets price a Democratic win near 97%", "No general-election polling exists, so the forecast rests on fundamentals and outside signals", "Marx has roughly matched Weiser in fundraising but is spending it quickly, limiting his closing resources"], "rationale": "Colorado's partisan lean, unanimous Solid/Safe D ratings from race raters, and prediction markets near 97% all point to Weiser holding the governorship for Democrats. Marx's competitive fundraising has not changed the race's shape, and the absence of polling keeps uncertainty somewhat elevated.", "watch": "Emerging polls showing a single-digit race, a sharply unfavorable national environment for Democrats, or Marx consolidating unaffiliated voters could tighten the contest.", "confidence": "medium", "notes": ["No usable general-election polls; forecast rests on fundamentals and expert ratings.", "Open seat: Jared Polis (D) is not on the ballot."]}, "overview": "Colorado's governorship is open this year as Jared Polis terms out, and Attorney General Phil Weiser carries the Democratic banner against Republican Victor Marx, with several minor-party candidates also on the ballot. The state's D+6 partisan lean and Democrats' strong recent record in statewide contests frame the race, though the open seat removes the incumbent edge Polis enjoyed.\n\nNo general-election polls have been published, so the picture rests on fundamentals and outside signals. Every major race rater scores Colorado Solid or Safe Democratic, and prediction markets put Democratic win odds near 97%. Fundraising has been competitive, with Marx roughly keeping pace with Weiser but burning cash quickly, without changing the race's overall shape. Weiser enters the final weeks as a clear favorite, with the open question being the size of the margin rather than the winner.", "history": [{"date": "2026-09-22", "p_dem": 0.9695, "margin": 12.28}, {"date": "2026-09-23", "p_dem": 0.9628, "margin": 12.0}, {"date": "2026-09-24", "p_dem": 0.9677, "margin": 12.5}, {"date": "2026-09-25", "p_dem": 0.9684, "margin": 12.5}, {"date": "2026-09-26", "p_dem": 0.9635, "margin": 12.5}]}