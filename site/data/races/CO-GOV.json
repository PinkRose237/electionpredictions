or_sd": 5.34, "poll_margin": null, "poll_sd": null, "poll_weight": 0.0, "fundamentals": {"margin": 8.6, "lean": 4.5, "environment": 4.1, "incumbency": 0.0, "money": 0.0}, "rating_margin": 14.83, "sigma_race": 6.5, "sigma_total": 6.88, "baseline_margin": 12.34, "analyst_adjustment": 0.16, "key_factors": ["Colorado's D+6 lean plus a favorable midterm environment for Democrats", "All six expert raters call the race Solid or Safe Democratic", "Prediction markets on Kalshi, Polymarket, and PredictIt each price a Democratic win near 97%", "Open seat without Polis; Marx's rapid spending and skipped debates limit Republican traction"], "rationale": "Colorado's Democratic lean, a favorable midterm environment, unanimous Solid/Safe Democratic ratings from six professional raters, and markets pricing a Democratic win near 97% all point the same way, and no polling contradicts them. The open seat removes Polis's personal edge but does not overturn the state's structural advantage.", "watch": "Any general-election polling showing a single-digit race, or Marx consolidating his fundraising and nationalizing the contest, would be the main signals of a tighter finish.", "confidence": "medium", "notes": ["No usable general-election polls; forecast rests on fundamentals and expert ratings.", "Open seat: Jared Polis (D) is not on the ballot."]}, "overview": "Colorado's governorship is open as Jared Polis terms out, with Attorney General Phil Weiser carrying the Democratic banner against Republican Victor Marx. The state's D+6 lean and a favorable midterm environment give Democrats a clear structural edge, and the several independent and minor-party candidates on the ballot are not viewed as serious factors.\n\nNo general-election polling is available, but the rest of the evidence lines up: all six professional raters call the race Solid or Safe Democratic, and markets on Kalshi, Polymarket, and PredictIt each price a Democratic win near 97%. Marx has kept pace with Weiser in fundraising but is burning through cash quickly, and he skipped the first debate. Everything points to Weiser winning by a comfortable double-digit margin.", "history": [{"date": "2026-09-22", "p_dem": 0.9695, "margin": 12.28}, {"date": "2026-09-23", "p_dem": 0.9628, "margin": 12.0}, {"date": "2026-09-24", "p_dem": 0.9677, "margin": 12.5}, {"date": "2026-09-25", "p_dem": 0.9684, "margin": 12.5}, {"date": "2026-09-26", "p_dem": 0.9635, "margin": 12.5}, {"date": "2026-09-27", "p_dem": 0.9625, "margin": 12.5}]}