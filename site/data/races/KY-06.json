 meaningful uncertainty, consistent with a Lean Republican rating.", "history": [{"date": "2026-09-22", "p_dem": 0.2515, "margin": -3.92}, {"date": "2026-09-23", "p_dem": 0.296, "margin": -4.0}, {"date": "2026-09-24", "p_dem": 0.2877, "margin": -4.0}, {"date": "2026-09-25", "p_dem": 0.2982, "margin": -4.0}, {"date": "2026-09-26", "p_dem": 0.223, "margin": -4.5}, {"date": "2026-09-27", "p_dem": 0.2389, "margin": -4.0}, {"date": "2026-09-28", "p_dem": 0.2735, "margin": -4.0}]}