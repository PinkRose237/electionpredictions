able Democratic hold.", "history": [{"date": "2026-09-22", "p_dem": 0.989, "margin": 20.81}, {"date": "2026-09-23", "p_dem": 0.9938, "margin": 20.5}, {"date": "2026-09-24", "p_dem": 0.9879, "margin": 20.9}, {"date": "2026-09-25", "p_dem": 0.9946, "margin": 21.5}, {"date": "2026-09-26", "p_dem": 0.9957, "margin": 21.5}]}