ited risk to the incumbent.", "history": [{"date": "2026-09-22", "p_dem": 0.9502, "margin": 10.95}, {"date": "2026-09-23", "p_dem": 0.9343, "margin": 10.0}, {"date": "2026-09-24", "p_dem": 0.945, "margin": 11.0}, {"date": "2026-09-25", "p_dem": 0.941, "margin": 10.5}, {"date": "2026-09-26", "p_dem": 0.9142, "margin": 10.0}, {"date": "2026-09-27", "p_dem": 0.9277, "margin": 10.5}, {"date": "2026-09-28", "p_dem": 0.9289, "margin": 10.0}, {"date": "2026-09-29", "p_dem": 0.9426, "margin": 10.5}, {"date": "2026-09-30", "p_dem": 0.9484, "margin": 11.0}, {"date": "2026-10-01", "p_dem": 0.9571, "margin": 11.0}, {"date": "2026-10-02", "p_dem": 0.9504, "margin": 10.5}, {"date": "2026-10-03", "p_dem": 0.9439, "margin": 10.5}, {"date": "2026-10-04", "p_dem": 0.9519, "margin": 11.0}, {"date": "2026-10-05", "p_dem": 0.9242, "margin": 10.0}, {"date": "2026-10-06", "p_dem": 0.9375, "margin": 10.5}, {"date": "2026-10-07", "p_dem": 0.9272, "margin": 10.0}, {"date": "2026-10-08", "p_dem": 0.9359, "margin": 10.5}]}