urce": "WLKY", "published": "2026-05-30T07:00:00+00:00", "url": "https://news.google.com/rss/articles/CBMihgFBVV95cUxQODdZSV8yYlhBNmd2ZkZhRkhqTTZNMm1sczJKNlVaRFM1aVJyckJjWUI4a1JTMUFYMVJ0S0hjdUpvaU8walB5N29fNHdTWjlUU1VkQ3pvSjNJdkpWTzVWbnJNVXcwci1rQzdGblNMaWgzeHpfT3FRR2JxMUVOYmFXcFRlSm1OUQ?oc=5"}, {"title": "Andy Beshear gains ground in 2028 Democratic presidential poll", "source": "FOX 56 News", "published": "2026-05-29T07:00:00+00:00", "url": "https://news.google.?oc=5"}, {"title": "Beshear’s popularity rises as potential 2028 candidate", "source": "WOWK 13 News", "published": "2026-05-28T07:00:00+00:00", "url": "https://news.google.?oc=5"}], "model": {"prior_margin": -15.0, "prior_sd": 7.0, "poll_margin": null, "poll_sd": null, "poll_weight": 0.0, "fundamentals": {"margin": -15.0, "lean": -15.0, "environment": 0.0, "incumbency": 0.0, "money": 0.0}, "rating_margin": null, "sigma_race": 9.5, "sigma_total": 11.54, "baseline_margin": -15.0, "analyst_adjustment": 0.0, "key_factors": ["Kentucky's R+15 partisan lean anchors the race to fundamentals", "Open-seat contest with no incumbent advantage on the ballot", "No Kentucky polls or expert ratings yet exist to test the lean", "Beshear's home-state popularity offers Democrats a messenger but no evidence of presidential movement"], "rationale": "Kentucky's fifteen-point Republican lean and the absence of any in-state polling or expert ratings keep this forecast resting on fundamentals. Beshear's rising popularity and 2028 buzz give Democrats a plausible home-state messenger, but nothing yet shows that translating into a narrower presidential race.", "watch": "Any Kentucky-specific polling testing a Beshear-led Democratic ticket, or a national environment strong enough to compress margins in deep-red states.", "confidence": "medium", "notes": ["No expert ratings published yet; forecast rests on fundamentals and polls.", "New or vacant seat with no expert ratings; fundamentals only.", "No usable general-election polls; forecast rests on fundamentals and expert ratings."]}, "overview": "Kentucky remains one of the most reliably Republican states in presidential politics, with a partisan lean of roughly fifteen points toward the GOP. The 2028 race is an open contest with the incumbent term-limited, and no candidate field, polling, or expert ratings yet exist to test that lean.\n\nThe main Democratic storyline is Governor Andy Beshear, whose rising popularity and cross-country travels have fueled 2028 speculation. But Kentucky's statewide results have repeatedly diverged from its presidential ones, and no in-state polling yet shows that popularity carrying into a federal race. Until evidence emerges, the state's fundamentals point to a comfortable Republican margin, with wide uncertainty this far from Election Day.", "history": [{"date": "2026-09-23", "p_dem": 0.0468, "margin": -15.0}, {"date": "2026-09-24", "p_dem": 0.1024, "margin": -14.0}, {"date": "2026-09-25", "p_dem": 0.09, "margin": -15.0}, {"date": "2026-09-26", "p_dem": 0.1001, "margin": -14.0}, {"date": "2026-09-27", "p_dem": 0.1139, "margin": -13.0}, {"date": "2026-09-28", "p_dem": 0.083, "margin": -15.0}, {"date": "2026-09-29", "p_dem": 0.1075, "margin": -14.0}, {"date": "2026-09-30", "p_dem": 0.0972, "margin": -14.5}, {"date": "2026-10-01", "p_dem": 0.0925, "margin": -14.5}, {"date": "2026-10-02", "p_dem": 0.1205, "margin": -13.0}, {"date": "2026-10-03", "p_dem": 0.1537, "margin": -11.0}, {"date": "2026-10-04", "p_dem": 0.1065, "margin": -13.5}, {"date": "2026-10-05", "p_dem": 0.153, "margin": -11.5}, {"date": "2026-10-06", "p_dem": 0.1005, "margin": -14.0}, {"date": "2026-10-07", "p_dem": 0.0891, "margin": -15.0}]}